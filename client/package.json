{
  "name": "profiles-client",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 client for browsing and saving random-user profiles",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
